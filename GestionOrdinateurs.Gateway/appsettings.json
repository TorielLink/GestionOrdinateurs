{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Keycloak": {
    "MetadataAddress": "http://localhost:8180/realms/gestionordinateurs/.well-known/openid-configuration",
    "Issuer": "http://localhost:8180/realms/gestionordinateurs"
  },
  "ReverseProxy": {
    "Routes": {
      "ordinateurs-route": {
        "ClusterId": "api-cluster",
        "AuthorizationPolicy": "default",
        "Match": { "Path": "/api/ordinateurs/{**catch-all}" }
      },
      "reparation-route": {
        "ClusterId": "api-cluster",
        "AuthorizationPolicy": "default",
        "Match": { "Path": "/api/reparation/{**catch-all}" }
      }
    },
    "Clusters": {
      "api-cluster": {
        "Destinations": {
          "api": { "Address": "http://gestionordinateurs-api:5127/" }
        }
      }
    }
  }
}
