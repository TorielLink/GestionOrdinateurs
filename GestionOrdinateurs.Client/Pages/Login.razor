@page "/login"
@using Blazored.SessionStorage
@using GestionOrdinateurs.Shared
@inject HttpClient Http
@inject ISessionStorageService SessionStorage
@inject NavigationManager Navigation
@inject JwtAuthenticationStateProvider AuthProvider

<PageTitle>Login</PageTitle>

<h1>Se connecter</h1>

<input @bind="login" placeholder="Utilisateur" />
<input type="password" @bind="motDePasse" placeholder="Mot de passe" />

<button @onclick="SeConnecter">Se connecter</button>

@if (!string.IsNullOrEmpty(message))
{
    <p>@message</p>
}

@code {
    private string login = string.Empty;
    private string motDePasse = string.Empty;
    private string message = string.Empty;

    private async Task SeConnecter()
    {
        var reponse = await Http.PostAsJsonAsync(
            "http://localhost:5157/api/auth/login",
            new LoginKeycloakRequest(login, motDePasse));

        if (!reponse.IsSuccessStatusCode)
        {
            message = "Identifiant ou mot de passe incorrect";
            return;
        }

        KeycloakTokenResponse? token = await reponse.Content.ReadFromJsonAsync<KeycloakTokenResponse>();

        await SessionStorage.SetItemAsync("jwtToken", token!.AccessToken);
        AuthProvider.NotifyUserAuthentication(token.AccessToken);
        Navigation.NavigateTo("/");
    }
}